FROM node:22-bookworm AS frontend

WORKDIR /build

COPY cmd/webmgr/frontend/package.json cmd/webmgr/frontend/package-lock.json ./
RUN npm config set registry https://registry.npmmirror.com && npm ci

COPY cmd/webmgr/frontend/ ./
RUN npm run build

FROM golang:1.26-bookworm AS builder

WORKDIR /src

RUN echo 'deb http://mirrors.ustc.edu.cn/debian bookworm main' > /etc/apt/sources.list \
    && echo 'deb http://mirrors.ustc.edu.cn/debian-security bookworm-security main' >> /etc/apt/sources.list \
    && apt-get update && apt-get install -y build-essential

COPY . /src
COPY --from=frontend /dist /src/cmd/webmgr/dist

RUN cd /src/cmd/webmgr && go mod download && go build -ldflags="-s -w" -o /webmgr .

FROM debian:bookworm-slim

WORKDIR /app

RUN echo 'deb http://mirrors.ustc.edu.cn/debian bookworm main' > /etc/apt/sources.list \
    && echo 'deb http://mirrors.ustc.edu.cn/debian-security bookworm-security main' >> /etc/apt/sources.list \
    && apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

COPY --from=builder /webmgr /app/webmgr
COPY cmd/webmgr/config.yaml /app/config.yaml

ENV APP_HOST=0.0.0.0
ENV APP_PORT=8081
ENV APP_DATA_DIR=/app/data
ENV METATUBE_API_HOST=0.0.0.0
ENV METATUBE_API_PORT=8080
ENV METATUBE_MOVIE_PROVIDER=JavBus

EXPOSE 8080 8081

VOLUME ["/app/data"]

CMD ["/app/webmgr"]
